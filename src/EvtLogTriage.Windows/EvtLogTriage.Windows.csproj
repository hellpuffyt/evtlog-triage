<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <RootNamespace>EvtLogTriage.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!--
      This project targets net8.0-windows and calls System.Diagnostics.Eventing.Reader,
      which is Windows-only. It is intentionally excluded from the solution's default build
      on non-Windows CI runners (see ci.yml) and is not required for the platform-neutral
      core or CLI to build, test, or run.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvtLogTriage.Core\EvtLogTriage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

</Project>
